{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hodor-docs",
  "compatibility_date": "2026-09-13",
  "main": "./src/index.ts",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "binding": "assets",
    "run_worker_first": ["/catalog", "/catalog/search"],
  },
  "routes": [
    {
      "pattern": "hodor.ing",
      "custom_domain": true,
    },
  ],
}
